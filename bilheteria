function controlarBilheteria() {
    // Criar lista vazia para armazenar os convidados
    const listaConvidados = [];
    let nome = '';

    // Laço enquanto a lista tiver menos de 50 convidados
    while (listaConvidados.length < 50) {
        // Perguntar o nome do convidado
        nome = prompt("Digite o nome do convidado (ou SAIR para encerrar):");
        
        // Converter para maiúsculo e verificar se o usuário quer encerrar
        if (nome.toUpperCase() === "SAIR") break;
        
        // Adicionar o convidado à lista
        listaConvidados.push(nome);
    }

    // Exibir mensagem final
    if (listaConvidados.length === 50) {
        console.log("Lotação esgotada! Temos 50 inscritos.");
    } else {
        console.log(`Foram cadastrados ${listaConvidados.length} convidados.`);
    }

    return listaConvidados; // Retorna a lista, caso queira usar depois
}
